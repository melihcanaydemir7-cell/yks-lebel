# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock.bak

# Generated localizations (regenerated by `flutter pub get`)
lib/l10n/app_localizations*.dart

# IDE
.idea/
.vscode/
*.iml
*.iws
.metadata.bak

# Secrets — never commit these.
# NOTE: `.env` itself IS committed with empty placeholders because pubspec
# declares it as an asset and the build fails without it. It must only ever
# hold *publishable* client values (Supabase anon key, AdMob unit ids — both
# ship inside the APK anyway). Real secrets (service-role key, keystores)
# belong in the files below or in `--dart-define` / CI secrets.
.env.local
.env.production
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*.jks
*.keystore

# Android
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/

# OS
.DS_Store
