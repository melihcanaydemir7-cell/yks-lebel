# Local configuration. Values here are PUBLISHABLE client identifiers only —
# they end up inside the APK. Never put a Supabase service-role key or any
# other real secret in this file.
#
# Leave everything empty to run fully offline against the bundled demo content.
# `--dart-define=KEY=value` overrides anything set here.

SUPABASE_URL=
SUPABASE_ANON_KEY=

ADMOB_ANDROID_APP_ID=
ADMOB_REWARDED_AD_UNIT_ID=
ADMOB_INTERSTITIAL_AD_UNIT_ID=

ADS_ENABLED=true
